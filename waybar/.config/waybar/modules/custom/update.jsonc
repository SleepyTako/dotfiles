{
	"custom/update": {
		"exec": "checkupdates | wc -l",
		// "exec-if":
		// "exec-on-event":
		"hide-empty-text": "0",
		// "return-type": "json",
		"interval": 3600,
		// "restart-interval":
		"signal": 1,
		"format": "",
		// "format-icons":
		// "rotate":
		// "align":
		// "justify":
		"min-length": 2,
		"max-length": 4,
		"on-click": "kitty -e $HOME/.config/waybar/scripts/update",
		// "on-click-middle":
		"on-click-right": "pkill -RTMIN+1 waybar",
		// "on-update":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "{} updates available"
		// "escape":
		// "menu":
		// "menu-file":
		// "menu-actions":
		// "expand":
	}
}
